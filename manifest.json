{
  "name": "Recorder",
  "default_locale": "en",
  "description": " Extension inspired by SeleniumBase Recorder",
  "version": "1.0.1",
  "author": "Michael Mintz",
  "homepage_url": "http://localhost:8080/",
  "manifest_version": 3,
  "permissions": [
    "notifications",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "contentScript.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": " Recorder is enabled",
    "default_icon": {
      "16": "images/recorder_icon.png"
    }
  },
  "icons": {
    "48": "images/recorder_icon.png",
    "128": "images/recorder_icon.png"
  },
  "host_permissions": [
    "http://localhost:5222/"
  ]
}